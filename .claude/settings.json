{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/coordinator-guard.sh\"",
            "statusMessage": "Kiểm vai trò điều phối"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/hooks/kb-sync.sh\"",
            "statusMessage": "Đồng bộ knowledge graph"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/journal-reminder.sh\"",
            "statusMessage": "Nhắc ghi chất liệu blog"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Agent"
    ]
  }
}
