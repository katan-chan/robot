#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Chạy Blender không giao diện cho repo này (18.7, 18.11).

In đúng một dòng JSON ra stdout. Exit 0 khi "ok": true, exit 1 khi có lỗi.
Lệnh con: version | build | inspect | export | exec | render. Xem blender/*.py.
"""
import argparse, json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT_BLEND = ROOT / "models/spider.blend"
CANDIDATES = (
    Path.home() / "Library/Application Support/Steam/steamapps/common/Blender/Blender.app/Contents/MacOS/Blender",
    Path("/Applications/Blender.app/Contents/MacOS/Blender"),
)
SCRIPTS = {"build": "build_spider.py", "inspect": "inspect_model.py", "export": "export_model.py", "render": "render_views.py"}
# a = các tham số sau "--": ["--result", <tmp.json>, ...]
VERSION_EXPR = ("import bpy, sys, json, platform; a = sys.argv[sys.argv.index('--') + 1:]; "
                "json.dump({'ok': True, 'blender': '.'.join(map(str, bpy.app.version)), "
                "'python': platform.python_version(), 'path': bpy.app.binary_path}, open(a[1], 'w'))")
EXEC_EXPR = ("import bpy, sys, json; a = sys.argv[sys.argv.index('--') + 1:]; exec(a[2]); "
             "bpy.context.preferences.filepaths.save_version = 0; bpy.ops.wm.save_mainfile(); "
             "json.dump({'ok': True, 'blend': bpy.data.filepath}, open(a[1], 'w'))")


def emit(obj):
    print(json.dumps(obj))
    sys.exit(0 if obj.get("ok") else 1)


def fail(check, obj, msg, fix):
    return {"ok": False, "errors": [{"check": check, "object": obj, "msg": msg, "fix": fix}]}


def find_blender():
    for p in (os.environ.get("BLENDER_BIN"), shutil.which("blender"), *CANDIDATES):
        if p and Path(p).is_file():
            return str(p)


class Parser(argparse.ArgumentParser):  # subparsers inherit this class
    def error(self, msg):
        emit(fail("args", "", msg, self.format_usage().strip()))


def main():
    p = Parser(prog="tools/blender")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("version")
    s = sub.add_parser("build")
    s.add_argument("--out", type=Path, default=DEFAULT_BLEND)
    s.add_argument("--servo", action="append", default=[], metavar="KIND=NAME")
    s.add_argument("--force", action="store_true")
    s = sub.add_parser("inspect")
    s.add_argument("--blend", type=Path, default=DEFAULT_BLEND)
    s = sub.add_parser("export")
    s.add_argument("--blend", type=Path, default=DEFAULT_BLEND)
    s.add_argument("--out", type=Path, default=ROOT / "build/model")
    s = sub.add_parser("exec")
    s.add_argument("--blend", type=Path, required=True)
    s.add_argument("--expr", required=True)
    s = sub.add_parser("render")
    s.add_argument("--blend", type=Path, default=DEFAULT_BLEND)
    s.add_argument("--out", type=Path, required=True)
    s.add_argument("--views", default="front,side,top,iso")
    a = p.parse_args()

    blender = find_blender()
    if not blender:
        emit(fail("blender", "", "không tìm thấy Blender", "đặt BLENDER_BIN hoặc cài Blender 5.2"))
    blend = getattr(a, "blend", None)
    if blend and not blend.is_file():
        emit(fail("blend", str(blend), "không có file .blend", "chạy tools/blender build trước"))

    with tempfile.TemporaryDirectory() as tmp:
        result = Path(tmp) / "result.json"
        cmd = [blender, "-b", "--factory-startup"]
        if blend:
            cmd.append(str(blend.resolve()))
        cmd += ["--python-exit-code", "1"]
        if a.cmd == "version":
            cmd += ["--python-expr", VERSION_EXPR]
        elif a.cmd == "exec":
            cmd += ["--python-expr", EXEC_EXPR]
        else:
            cmd += ["--python", str(ROOT / "blender" / SCRIPTS[a.cmd])]
        cmd += ["--", "--result", str(result)]
        if a.cmd == "build":
            cmd += ["--out", str(a.out.resolve()), *[x for s in a.servo for x in ("--servo", s)]]
            cmd += ["--force"] if a.force else []
        elif a.cmd == "exec":
            cmd.append(a.expr)
        elif a.cmd == "render":
            cmd += ["--out", str(a.out.resolve()), "--views", a.views]
        elif a.cmd == "export":
            cmd += ["--out", str(a.out.resolve())]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        try:
            out = json.loads(result.read_text())
        except (OSError, ValueError):
            log = "\n".join((proc.stderr or proc.stdout).strip().splitlines()[-20:])
            out = fail("blender", "", f"Blender exit {proc.returncode}: {log}", "xem lỗi Blender trong msg")
    emit(out)


if __name__ == "__main__":
    main()
